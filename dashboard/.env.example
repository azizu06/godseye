# Optional shared default for every browser served by this dashboard.
# Copy to .env.local, set the same backend used by the phone, and restart Vite.
# VITE_LIVE_URL=ws://10.0.0.44:8765/live

# Recommended for multiple viewers: relay through the dashboard server so each
# browser only needs to reach the dashboard laptop. The phone keeps its /phone URL.
# VITE_LIVE_URL=/live
# GODSEYE_BACKEND_URL=http://10.0.0.44:8765
